#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct Node {
    char name[100];
    int  count;
} Node;

int findCandidate(Node* table, int size, char* name) {
    for (int i = 0; i < size; i++)
        if (strcmp(table[i].name, name) == 0)
            return i;
    return -1;
}

int main() {
    int n;
    scanf("%d", &n);

    Node* table = (Node*)calloc(n, sizeof(Node));
    int   size  = 0;

    for (int i = 0; i < n; i++) {
        char name[100];
        scanf("%s", name);

        int idx = findCandidate(table, size, name);
        if (idx == -1) {
            strcpy(table[size].name, name);
            table[size].count = 1;
            size++;
        } else {
            table[idx].count++;
        }
    }

    int  maxVotes = 0;
    char winner[100] = "";

    for (int i = 0; i < size; i++) {
        if (table[i].count > maxVotes ||
           (table[i].count == maxVotes && strcmp(table[i].name, winner) < 0)) {
            maxVotes = table[i].count;
            strcpy(winner, table[i].name);
        }
    }

    printf("%s %d\n", winner, maxVotes);

    free(table);
    return 0;
}
