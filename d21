class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

# Create linked list
n = int(input())
arr = list(map(int, input().split()))

head = None

for value in arr:
    new_node = Node(value)
    if head is None:
        head = new_node
    else:
        temp = head
        while temp.next:
            temp = temp.next
        temp.next = new_node

# Traverse and print
temp = head
while temp:
    print(temp.data, end=" ")
    temp = temp.next
