
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int val;
    struct Node* next;
} Node;

Node* newNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val  = val;
    node->next = NULL;
    return node;
}

void addEdge(Node** adj, int u, int v) {
    Node* node = newNode(v);
    node->next = adj[u];
    adj[u]     = node;
}

int dfs(Node** adj, int* visited, int src, int parent) {
    visited[src] = 1;

    Node* temp = adj[src];
    while (temp != NULL) {
        if (!visited[temp->val]) {
            if (dfs(adj, visited, temp->val, src))
                return 1;
        } else if (temp->val != parent)
            return 1;
        temp = temp->next;
    }
    return 0;
}

void freeList(Node** adj, int n) {
    for (int i = 0; i < n; i++) {
        Node* temp = adj[i];
        while (temp != NULL) {
            Node* next = temp->next;
            free(temp);
            temp = next;
        }
    }
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    Node** adj = (Node**)calloc(n, sizeof(Node*));

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
        addEdge(adj, v, u);
    }

    int* visited = (int*)calloc(n, sizeof(int));
    int  cycle   = 0;

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            if (dfs(adj, visited, i, -1)) {
                cycle = 1;
                break;
            }
        }
    }

    printf("%s\n", cycle ? "YES" : "NO");

    freeList(adj, n);
    free(adj);
    free(visited);
    return 0;
}
