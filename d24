class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

# Create linked list
def create_list(arr):
    head = None
    tail = None
    for num in arr:
        new_node = Node(num)
        if head is None:
            head = tail = new_node
        else:
            tail.next = new_node
            tail = new_node
    return head

# Delete first occurrence of key
def delete_key(head, key):
    if head is None:
        return head

    # If head needs to be deleted
    if head.data == key:
        return head.next

    temp = head
    while temp.next:
        if temp.next.data == key:
            temp.next = temp.next.next
            break
        temp = temp.next

    return head

# Input
n = int(input())
arr = list(map(int, input().split()))
key = int(input())

# Create list
head = create_list(arr)

# Delete key
head = delete_key(head, key)

# Print result
temp = head
while temp:
    print(temp.data, end=" ")
    temp = temp.next
