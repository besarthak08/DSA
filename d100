#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int val, idx;
} Element;

int* result;

void mergeCount(Element* arr, Element* temp, int left, int mid, int right) {
    int i = left, j = mid + 1, k = left;

    while (i <= mid && j <= right) {
        if (arr[i].val <= arr[j].val) {
            result[arr[i].idx] += j - (mid + 1);
            temp[k++]           = arr[i++];
        } else {
            temp[k++] = arr[j++];
        }
    }

    while (i <= mid) {
        result[arr[i].idx] += j - (mid + 1);
        temp[k++]           = arr[i++];
    }

    while (j <= right)
        temp[k++] = arr[j++];

    for (int x = left; x <= right; x++)
        arr[x] = temp[x];
}

void mergeSort(Element* arr, Element* temp, int left, int right) {
    if (left >= right) return;
    int mid = left + (right - left) / 2;
    mergeSort(arr, temp, left, mid);
    mergeSort(arr, temp, mid + 1, right);
    mergeCount(arr, temp, left, mid, right);
}

int main() {
    int n;
    scanf("%d", &n);

    Element* arr  = (Element*)malloc(n * sizeof(Element));
    Element* temp = (Element*)malloc(n * sizeof(Element));
    result        = (int*)calloc(n, sizeof(int));

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i].val);
        arr[i].idx = i;
    }

    mergeSort(arr, temp, 0, n - 1);

    for (int i = 0; i < n; i++) {
        printf("%d", result[i]);
        if (i < n - 1) printf(" ");
    }
    printf("\n");

    free(arr);
    free(temp);
    free(result);
    return 0;
}
