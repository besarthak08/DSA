#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    int n;
    scanf("%d", &n);

    int* arr = (int*)malloc(n * sizeof(int));
    int  max = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] > max) max = arr[i];
    }

    int* freq = (int*)calloc(max + 1, sizeof(int));
    for (int i = 0; i < n; i++)
        freq[arr[i]]++;

    // Prefix sum
    for (int i = 1; i <= max; i++)
        freq[i] += freq[i - 1];

    int* output = (int*)malloc(n * sizeof(int));
    for (int i = n - 1; i >= 0; i--) {
        output[--freq[arr[i]]] = arr[i];
    }

    for (int i = 0; i < n; i++) {
        printf("%d", output[i]);
        if (i < n - 1) printf(" ");
    }
    printf("\n");

    free(arr);
    free(freq);
    free(output);
    return 0;
}
