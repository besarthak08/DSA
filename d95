#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    float val;
    struct Node* next;
} Node;

Node* newNode(float val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val  = val;
    node->next = NULL;
    return node;
}

void insertSorted(Node** bucket, float val) {
    Node* node = newNode(val);

    if (*bucket == NULL || (*bucket)->val >= val) {
        node->next = *bucket;
        *bucket    = node;
        return;
    }

    Node* curr = *bucket;
    while (curr->next != NULL && curr->next->val < val)
        curr = curr->next;

    node->next  = curr->next;
    curr->next  = node;
}

int main() {
    int n;
    scanf("%d", &n);

    float* arr = (float*)malloc(n * sizeof(float));
    for (int i = 0; i < n; i++)
        scanf("%f", &arr[i]);

    Node** buckets = (Node**)calloc(n, sizeof(Node*));

    // Distribute into buckets
    for (int i = 0; i < n; i++) {
        int idx = (int)(arr[i] * n);
        if (idx >= n) idx = n - 1;
        insertSorted(&buckets[idx], arr[i]);
    }

    // Concatenate buckets
    int k = 0;
    for (int i = 0; i < n; i++) {
        Node* temp = buckets[i];
        while (temp != NULL) {
            arr[k++]   = temp->val;
            Node* next = temp->next;
            free(temp);
            temp = next;
        }
    }

    for (int i = 0; i < n; i++) {
        printf("%.2f", arr[i]);
        if (i < n - 1) printf(" ");
    }
    printf("\n");

    free(arr);
    free(buckets);
    return 0;
}
