#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int val;
    struct Node* next;
} Node;

Node* newNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val  = val;
    node->next = NULL;
    return node;
}

void addEdge(Node** adj, int u, int v) {
    Node* node = newNode(v);
    node->next = adj[u];
    adj[u]     = node;
}

void printList(Node** adj, int n) {
    for (int i = 0; i < n; i++) {
        printf("%d -> ", i);
        Node* temp = adj[i];
        while (temp != NULL) {
            printf("%d", temp->val);
            if (temp->next != NULL) printf(" -> ");
            temp = temp->next;
        }
        printf("NULL\n");
    }
}

void freeList(Node** adj, int n) {
    for (int i = 0; i < n; i++) {
        Node* temp = adj[i];
        while (temp != NULL) {
            Node* next = temp->next;
            free(temp);
            temp = next;
        }
    }
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    Node** adj = (Node**)calloc(n, sizeof(Node*));

    int type;
    printf("Enter 0 for Undirected, 1 for Directed: ");
    scanf("%d", &type);

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
        if (type == 0)
            addEdge(adj, v, u);
    }

    printList(adj, n);

    freeList(adj, n);
    free(adj);
    return 0;
}
