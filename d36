#include <stdio.h>

#define MAX 100

int queue[MAX];
int front = 0, rear = -1, size = 0;

// Enqueue
void enqueue(int x) {
    if (size == MAX) return; // overflow ignored
    rear = (rear + 1) % MAX;
    queue[rear] = x;
    size++;
}

// Dequeue
void dequeue() {
    if (size == 0) return; // underflow ignored
    front = (front + 1) % MAX;
    size--;
}

int main() {
    int n, m, x;
    scanf("%d", &n);

    // Enqueue elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &x);
        enqueue(x);
    }

    // Number of dequeues
    scanf("%d", &m);

    // Perform dequeues
    for (int i = 0; i < m; i++) {
        dequeue();
    }

    // Display queue
    int i = front;
    for (int cnt = 0; cnt < size; cnt++) {
        printf("%d ", queue[i]);
        i = (i + 1) % MAX;
    }

    return 0;
}
