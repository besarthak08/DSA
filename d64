#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int val;
    struct Node* next;
} Node;

Node* newNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val  = val;
    node->next = NULL;
    return node;
}

void addEdge(Node** adj, int u, int v) {
    Node* node = newNode(v);
    node->next = adj[u];
    adj[u]     = node;
}

void bfs(Node** adj, int* visited, int n, int src) {
    int* queue = (int*)malloc(n * sizeof(int));
    int front  = 0, back = 0;

    visited[src]  = 1;
    queue[back++] = src;

    while (front < back) {
        int curr = queue[front++];
        printf("%d ", curr);

        Node* temp = adj[curr];
        while (temp != NULL) {
            if (!visited[temp->val]) {
                visited[temp->val]  = 1;
                queue[back++] = temp->val;
            }
            temp = temp->next;
        }
    }

    free(queue);
}

void freeList(Node** adj, int n) {
    for (int i = 0; i < n; i++) {
        Node* temp = adj[i];
        while (temp != NULL) {
            Node* next = temp->next;
            free(temp);
            temp = next;
        }
    }
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    Node** adj = (Node**)calloc(n, sizeof(Node*));

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
        addEdge(adj, v, u);
    }

    int s;
    scanf("%d", &s);

    int* visited = (int*)calloc(n, sizeof(int));

    printf("BFS Traversal: ");
    bfs(adj, visited, n, s);
    printf("\n");

    freeList(adj, n);
    free(adj);
    free(visited);
    return 0;
}
